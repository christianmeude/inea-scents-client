{
    "openapi": "3.0.0",
    "info": {
        "title": "Inea Scents API",
        "description": "API Documentation for Inea Scents",
        "version": "1.0.0"
    },
    "servers": [
        {
            "url": "/api",
            "description": "API Server"
        }
    ],
    "paths": {
        "/api/register": {
            "post": {
                "tags": [
                    "Auth"
                ],
                "summary": "Register a new user",
                "operationId": "8e4e3cb7b46126f4696379d3c7eeb4ad",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "name",
                                    "email",
                                    "password"
                                ],
                                "properties": {
                                    "name": {
                                        "type": "string",
                                        "example": "John Doe"
                                    },
                                    "email": {
                                        "type": "string",
                                        "format": "email",
                                        "example": "john@example.com"
                                    },
                                    "password": {
                                        "type": "string",
                                        "format": "password",
                                        "example": "secret"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "User registered successfully",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/AuthResponse"
                                }
                            }
                        }
                    },
                    "422": {
                        "description": "Validation Error"
                    }
                }
            }
        },
        "/api/login": {
            "post": {
                "tags": [
                    "Auth"
                ],
                "summary": "Login user and return token",
                "operationId": "222b2625838e3c57e017987f73598fda",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "email",
                                    "password"
                                ],
                                "properties": {
                                    "email": {
                                        "type": "string",
                                        "format": "email",
                                        "example": "john@example.com"
                                    },
                                    "password": {
                                        "type": "string",
                                        "format": "password",
                                        "example": "secret"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "User logged in successfully",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/AuthResponse"
                                }
                            }
                        }
                    },
                    "422": {
                        "description": "Invalid credentials or Validation Error"
                    }
                }
            }
        },
        "/api/availability": {
            "get": {
                "tags": [
                    "Availability"
                ],
                "summary": "Get availability calendar for a given month and year",
                "description": "Returns a list of dates for the requested month marked as 'Booked' or 'Available'.",
                "operationId": "getAvailability",
                "parameters": [
                    {
                        "name": "month",
                        "in": "query",
                        "description": "Month number (1-12). Defaults to current month.",
                        "required": false,
                        "schema": {
                            "type": "integer",
                            "maximum": 12,
                            "minimum": 1
                        }
                    },
                    {
                        "name": "year",
                        "in": "query",
                        "description": "Year (e.g. 2024). Defaults to current year.",
                        "required": false,
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Successful operation",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "array",
                                    "items": {
                                        "properties": {
                                            "date": {
                                                "type": "string",
                                                "format": "date",
                                                "example": "2024-08-01"
                                            },
                                            "status": {
                                                "type": "string",
                                                "example": "Available"
                                            }
                                        },
                                        "type": "object"
                                    }
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/bookings": {
            "get": {
                "tags": [
                    "Bookings"
                ],
                "summary": "Get user's bookings",
                "description": "Returns a list of all bookings for the authenticated user",
                "operationId": "4535e967ef15bc76dadf1efa40192f0d",
                "parameters": [
                    {
                        "name": "status",
                        "in": "query",
                        "description": "Filter bookings by status",
                        "required": false,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Successful operation",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "data": {
                                            "type": "array",
                                            "items": {
                                                "$ref": "#/components/schemas/Booking"
                                            }
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    }
                },
                "security": [
                    {
                        "sanctum": []
                    }
                ]
            },
            "post": {
                "tags": [
                    "Bookings"
                ],
                "summary": "Create a new booking",
                "description": "Creates a new booking for the authenticated user",
                "operationId": "43e6dcca842886074084b8db86af7802",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "package_id",
                                    "customer_name",
                                    "customer_email",
                                    "pax",
                                    "event_date",
                                    "venue_address",
                                    "payment_method"
                                ],
                                "properties": {
                                    "package_id": {
                                        "type": "integer"
                                    },
                                    "customer_name": {
                                        "type": "string"
                                    },
                                    "customer_email": {
                                        "type": "string"
                                    },
                                    "customer_phone": {
                                        "type": "string"
                                    },
                                    "pax": {
                                        "type": "integer"
                                    },
                                    "event_date": {
                                        "type": "string",
                                        "format": "date"
                                    },
                                    "event_time": {
                                        "type": "string",
                                        "format": "time"
                                    },
                                    "venue_address": {
                                        "type": "string"
                                    },
                                    "payment_method": {
                                        "type": "string",
                                        "enum": [
                                            "credit_card",
                                            "cash",
                                            "bank_transfer"
                                        ]
                                    },
                                    "scent_ids": {
                                        "type": "array",
                                        "items": {
                                            "type": "integer"
                                        }
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Booking created successfully",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "data": {
                                            "$ref": "#/components/schemas/Booking"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    }
                },
                "security": [
                    {
                        "sanctum": []
                    }
                ]
            }
        },
        "/api/packages": {
            "get": {
                "tags": [
                    "Packages"
                ],
                "summary": "Get list of packages",
                "description": "Returns list of available packages.",
                "operationId": "2d2d4df67a3ce58700702ed1c7827acd",
                "responses": {
                    "200": {
                        "description": "Successful operation",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "data": {
                                            "type": "array",
                                            "items": {
                                                "$ref": "#/components/schemas/Package"
                                            }
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/packages/{package}": {
            "get": {
                "tags": [
                    "Packages"
                ],
                "summary": "Get package details",
                "description": "Returns full package details for a specific ID.",
                "operationId": "c19853188beb894fc87c73ab5e2cdc0b",
                "parameters": [
                    {
                        "name": "package",
                        "in": "path",
                        "description": "ID of package to return",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Successful operation",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "data": {
                                            "$ref": "#/components/schemas/Package"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "404": {
                        "description": "Package not found",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "message": {
                                            "type": "string"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/wishlist": {
            "get": {
                "tags": [
                    "Wishlist"
                ],
                "summary": "Get user's wishlist",
                "operationId": "25e51433040f79ef596ee4001198d4f2",
                "responses": {
                    "200": {
                        "description": "List of wishlist packages",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "data": {
                                            "type": "array",
                                            "items": {
                                                "$ref": "#/components/schemas/Package"
                                            }
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    }
                },
                "security": [
                    {
                        "sanctum": []
                    }
                ]
            }
        },
        "/api/wishlist/toggle": {
            "post": {
                "tags": [
                    "Wishlist"
                ],
                "summary": "Toggle package in wishlist",
                "operationId": "c690ac875ef9156df71fdce102c96867",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "package_id"
                                ],
                                "properties": {
                                    "package_id": {
                                        "type": "integer",
                                        "example": 1
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Toggle status",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "attached": {
                                            "type": "boolean"
                                        },
                                        "message": {
                                            "type": "string"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Unauthenticated"
                    },
                    "422": {
                        "description": "Validation Error"
                    }
                },
                "security": [
                    {
                        "sanctum": []
                    }
                ]
            }
        }
    },
    "components": {
        "schemas": {
            "AuthResponse": {
                "properties": {
                    "user": {
                        "properties": {
                            "id": {
                                "type": "integer",
                                "example": 1
                            },
                            "name": {
                                "type": "string",
                                "example": "John Doe"
                            },
                            "email": {
                                "type": "string",
                                "example": "john@example.com"
                            }
                        },
                        "type": "object"
                    },
                    "access_token": {
                        "type": "string",
                        "example": "1|abcdef..."
                    },
                    "token_type": {
                        "type": "string",
                        "example": "Bearer"
                    }
                },
                "type": "object"
            },
            "Booking": {
                "title": "Booking",
                "properties": {
                    "id": {
                        "type": "integer"
                    },
                    "booking_reference": {
                        "type": "string"
                    },
                    "user_id": {
                        "type": "integer",
                        "nullable": true
                    },
                    "customer_name": {
                        "type": "string"
                    },
                    "customer_email": {
                        "type": "string"
                    },
                    "customer_phone": {
                        "type": "string",
                        "nullable": true
                    },
                    "pax": {
                        "type": "integer"
                    },
                    "event_date": {
                        "type": "string",
                        "format": "date-time"
                    },
                    "event_time": {
                        "type": "string",
                        "nullable": true
                    },
                    "venue_address": {
                        "type": "string"
                    },
                    "payment_method": {
                        "type": "string"
                    },
                    "status": {
                        "type": "string"
                    },
                    "package": {
                        "$ref": "#/components/schemas/Package"
                    },
                    "scents": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/Scent"
                        }
                    }
                },
                "type": "object"
            },
            "Package": {
                "title": "Package",
                "description": "Package model",
                "properties": {
                    "id": {
                        "type": "integer",
                        "example": 1
                    },
                    "name": {
                        "type": "string",
                        "example": "Romantic Getaway"
                    },
                    "description": {
                        "type": "string",
                        "example": "A nice package for couples.",
                        "nullable": true
                    },
                    "inclusions": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        }
                    },
                    "pax_options": {
                        "type": "array",
                        "items": {
                            "type": "integer"
                        }
                    },
                    "freebies": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        }
                    },
                    "price": {
                        "type": "number",
                        "format": "float",
                        "example": 199.99
                    },
                    "rating": {
                        "type": "number",
                        "format": "float",
                        "example": 4.5
                    },
                    "reviews_count": {
                        "type": "integer",
                        "example": 120
                    },
                    "images": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        }
                    },
                    "gallery_images": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        }
                    },
                    "scents": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/Scent"
                        }
                    },
                    "created_at": {
                        "type": "string",
                        "format": "date-time",
                        "nullable": true
                    },
                    "updated_at": {
                        "type": "string",
                        "format": "date-time",
                        "nullable": true
                    }
                },
                "type": "object"
            },
            "Scent": {
                "title": "Scent",
                "description": "Scent model",
                "properties": {
                    "id": {
                        "type": "integer",
                        "example": 1
                    },
                    "name": {
                        "type": "string",
                        "example": "Lavender"
                    },
                    "description": {
                        "type": "string",
                        "example": "A calming floral scent.",
                        "nullable": true
                    },
                    "image_url": {
                        "type": "string",
                        "example": "https://example.com/lavender.jpg",
                        "nullable": true
                    },
                    "is_available": {
                        "type": "boolean",
                        "example": true
                    },
                    "created_at": {
                        "type": "string",
                        "format": "date-time",
                        "nullable": true
                    },
                    "updated_at": {
                        "type": "string",
                        "format": "date-time",
                        "nullable": true
                    }
                },
                "type": "object"
            }
        }
    },
    "tags": [
        {
            "name": "Availability",
            "description": "API Endpoints for Availability Calendar"
        },
        {
            "name": "Bookings",
            "description": "API Endpoints for User Bookings"
        },
        {
            "name": "Packages",
            "description": "API Endpoints for Packages"
        },
        {
            "name": "Auth",
            "description": "Auth"
        },
        {
            "name": "Wishlist",
            "description": "Wishlist"
        }
    ]
}